rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function logged() {
      return request.auth != null;
    }

    function hasStaffDocument() {
      return logged()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }

    function staff() {
      return hasStaffDocument()
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.ativo == true;
    }

    function admin() {
      return staff()
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.perfil == "administrador";
    }

    function cashier() {
      return staff()
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.perfil in ["administrador", "caixa"];
    }

    function serviceStaff() {
      return staff()
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.perfil in ["administrador", "caixa", "atendimento"];
    }

    function activeTable(tableToken) {
      return exists(/databases/$(database)/documents/mesas/$(tableToken))
        && get(/databases/$(database)/documents/mesas/$(tableToken)).data.ativa == true;
    }

    function validAccountData(tableToken, accountData) {
      return accountData.mesaToken == tableToken
        && accountData.status == "aberta"
        && accountData.responsavel is string
        && accountData.responsavel.size() >= 2
        && accountData.sessaoId is string
        && activeTable(tableToken)
        && accountData.mesaNumero == get(/databases/$(database)/documents/mesas/$(tableToken)).data.numero;
    }

    function activeAccountMatches(orderData) {
      return exists(/databases/$(database)/documents/contas_ativas/$(orderData.mesaToken))
        && get(/databases/$(database)/documents/contas_ativas/$(orderData.mesaToken)).data.sessaoId == orderData.sessaoId
        && get(/databases/$(database)/documents/contas_ativas/$(orderData.mesaToken)).data.mesaNumero == orderData.mesaNumero
        && get(/databases/$(database)/documents/contas_ativas/$(orderData.mesaToken)).data.responsavel == orderData.responsavelConta;
    }

    function validOrderData(orderData) {
      return orderData.status == "novo"
        && orderData.statusImpressao == "pendente"
        && orderData.mesaToken is string
        && orderData.sessaoId is string
        && orderData.solicitadoPor is string
        && orderData.solicitadoPor.size() >= 2
        && orderData.itens is list
        && orderData.itens.size() > 0
        && orderData.itens.size() <= 50
        && orderData.total is number
        && orderData.total >= 0
        && activeAccountMatches(orderData);
    }

    function sameActiveTableSession(orderData) {
      return logged()
        && exists(/databases/$(database)/documents/contas_ativas/$(orderData.mesaToken))
        && get(/databases/$(database)/documents/contas_ativas/$(orderData.mesaToken)).data.sessaoId == orderData.sessaoId;
    }

    match /configuracoes/{documentId} {
      allow get: if documentId == "publico" || staff();
      allow list: if staff();
      allow create, update, delete: if admin();
    }

    match /catalogo_meta/{documentId} {
      allow get: if true;
      allow list: if staff();
      allow create, update, delete: if admin();
    }

    match /categorias/{categoryId} {
      allow get: if resource.data.ativa == true || staff();
      allow list: if staff() || resource.data.ativa == true;
      allow create, update, delete: if admin();
    }

    match /produtos/{productId} {
      allow get: if resource.data.ativo == true || staff();
      allow list: if staff() || resource.data.ativo == true;
      allow create, update, delete: if admin();
    }

    match /mesas/{tableToken} {
      allow get: if true;
      allow list: if staff();
      allow create, update, delete: if admin();
    }

    match /contas_ativas/{tableToken} {
      allow get: if logged();
      allow list: if staff();

      allow create: if validAccountData(tableToken, request.resource.data)
        && (
          (
            logged()
            && !staff()
            && request.resource.data.responsavelUid == request.auth.uid
          )
          ||
          (
            serviceStaff()
            && request.resource.data.responsavelUid == request.auth.uid
            && request.resource.data.abertaPorTipo == "atendente"
            && request.resource.data.abertaPorUid == request.auth.uid
          )
        );

      allow update, delete: if cashier();
    }

    match /pedidos/{orderId} {
      allow create: if validOrderData(request.resource.data)
        && (
          (
            logged()
            && !staff()
            && request.resource.data.clienteUid == request.auth.uid
          )
          ||
          (
            serviceStaff()
            && request.resource.data.clienteUid == request.auth.uid
            && request.resource.data.origemPedido == "atendente"
            && request.resource.data.atendenteUid == request.auth.uid
          )
        );

      allow read: if staff() || sameActiveTableSession(resource.data);

      allow update: if serviceStaff()
        || (
          logged()
          && !staff()
          && sameActiveTableSession(resource.data)
          && resource.data.status in ["novo", "aceito", "preparo", "pronto"]
          && request.resource.data.status == "entregue"
          && request.resource.data.entreguePorClienteUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "status",
            "entregueEm",
            "entreguePorClienteUid",
            "atualizadoEm"
          ])
        );

      allow delete: if admin();
    }

    match /historico_contas/{accountId} {
      allow read: if staff();
      allow create: if cashier();
      allow update, delete: if admin();
    }

    match /usuarios/{userId} {
      allow get: if logged() && (request.auth.uid == userId || admin());
      allow list: if admin();
      allow create, update, delete: if admin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
