rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function logged() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }

    function staff() {
      return logged()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && userDoc().data.ativo == true;
    }

    function admin() {
      return staff() && userDoc().data.perfil == "administrador";
    }

    function caixa() {
      return staff() && userDoc().data.perfil in ["administrador", "caixa"];
    }

    function atendimento() {
      return staff() && userDoc().data.perfil in ["administrador", "caixa", "atendimento"];
    }

    match /configuracoes/{docId} {
      allow read: if docId == "publico" || staff();
      allow write: if admin();
    }

    match /categorias/{id} {
      allow read: if true;
      allow write: if admin();
    }

    match /produtos/{id} {
      allow read: if resource.data.ativo == true || staff();
      allow write: if admin();
    }

    match /mesas/{token} {
      allow read: if true;
      allow write: if admin();
    }

    match /contas_ativas/{mesaToken} {
      allow read: if logged();
      allow create: if logged()
        && !staff()
        && request.resource.data.mesaToken == mesaToken
        && request.resource.data.status == "aberta"
        && request.resource.data.responsavel is string
        && request.resource.data.responsavel.size() >= 2
        && request.resource.data.sessaoId is string
        && exists(/databases/$(database)/documents/mesas/$(mesaToken))
        && get(/databases/$(database)/documents/mesas/$(mesaToken)).data.ativa == true;
      allow update, delete: if caixa();
    }

    match /pedidos/{pedidoId} {
      allow create: if logged()
        && !staff()
        && request.resource.data.clienteUid == request.auth.uid
        && request.resource.data.status == "novo"
        && request.resource.data.mesaToken is string
        && request.resource.data.sessaoId is string
        && request.resource.data.solicitadoPor is string
        && request.resource.data.solicitadoPor.size() >= 2
        && request.resource.data.itens is list
        && request.resource.data.itens.size() > 0
        && exists(/databases/$(database)/documents/contas_ativas/$(request.resource.data.mesaToken))
        && get(/databases/$(database)/documents/contas_ativas/$(request.resource.data.mesaToken)).data.sessaoId
           == request.resource.data.sessaoId;

      allow read: if staff() || (logged() && resource.data.clienteUid == request.auth.uid);
      allow update: if atendimento();
      allow delete: if admin();
    }

    match /historico_contas/{id} {
      allow read: if staff();
      allow create: if caixa();
      allow update, delete: if admin();
    }

    match /usuarios/{uid} {
      allow read: if logged() && (request.auth.uid == uid || admin());
      allow create, update, delete: if admin();
    }
  }
}
